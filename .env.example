NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:3001
DOCS_ENABLED=true
DATABASE_URL=postgresql://wordquest:wordquest@localhost:5432/wordquest?schema=public

# Frontend API endpoint
VITE_API_BASE_URL=http://localhost:3001

# Agnes server-only story generation. Never use a VITE_ prefix for secrets.
AGNES_API_KEY=
# LLM_API_KEY remains available as a generic, higher-priority alias.
LLM_API_KEY=
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_MODEL=agnes-2.0-flash
LLM_API_STYLE=chat-completions
LLM_PROVIDER=agnes
# Agnes 官方文档未声明 JSON Schema 参数支持，因此使用提示词 JSON + 服务端严格校验。
LLM_OUTPUT_MODE=prompt-only
# 可选：留空时使用项目内置的个性化故事系统提示词。
LLM_SYSTEM_PROMPT=
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
LLM_RATE_LIMIT_PER_MINUTE=5
