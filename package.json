{
  "name": "wordquest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "preview": "vite preview",
    "build": "pnpm build:web && pnpm build:api",
    "build:web": "tsc -b && vite build && node scripts/generate-service-worker.mjs",
    "build:api": "pnpm db:generate && tsc -p server/tsconfig.json",
    "build:android-web": "tsc -b && vite build --mode android && node scripts/generate-service-worker.mjs",
    "android:sync": "pnpm build:android-web && cap sync android",
    "android:open": "cap open android",
    "android:apk": "node scripts/build-android.mjs",
    "android:assets": "capacitor-assets generate --android",
    "start:api": "node dist-server/index.js",
    "api:openapi": "tsx server/scripts/export-openapi.ts",
    "llm:test": "tsx server/scripts/test-story-model.ts",
    "vocabulary:import": "tsx server/scripts/import-vocabulary-json.ts",
    "test": "vitest run",
    "test:api": "vitest run server",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm db:validate && pnpm test && pnpm build && pnpm api:openapi",
    "test:db": "vitest run prisma server/database"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/env": "^7.0.0",
    "@fastify/swagger": "^9.8.0",
    "@fastify/swagger-ui": "^6.1.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@vitejs/plugin-react": "^6.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "lucide-react": "^1.24.0",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^8.1.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "prisma": "^7.8.0",
    "tsx": "^4.23.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
