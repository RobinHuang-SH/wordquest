const VERSION = __WORDQUEST_VERSION__
const PRECACHE = 'wordquest-precache-' + VERSION
const RUNTIME = 'wordquest-runtime-' + VERSION
const APP_SHELL = __WORDQUEST_APP_SHELL__

self.addEventListener('install', (event) => {
  event.waitUntil(caches.open(PRECACHE).then((cache) => cache.addAll(APP_SHELL)))
})

self.addEventListener('activate', (event) => {
  event.waitUntil(
    caches
      .keys()
      .then((keys) =>
        Promise.all(
          keys
            .filter((key) => key.startsWith('wordquest-') && key !== PRECACHE && key !== RUNTIME)
            .map((key) => caches.delete(key)),
        ),
      )
      .then(() => self.clients.claim()),
  )
})

self.addEventListener('message', (event) => {
  if (event.data?.type === 'SKIP_WAITING') self.skipWaiting()
  if (event.data?.type === 'CLEAR_RUNTIME_CACHE') {
    event.waitUntil(caches.delete(RUNTIME))
  }
})

async function cacheResponse(cacheName, request, response) {
  if (response.ok && response.type !== 'opaque') {
    const cache = await caches.open(cacheName)
    await cache.put(request, response.clone())
  }
  return response
}

async function handleNavigation(request) {
  try {
    const response = await fetch(request)
    return cacheResponse(RUNTIME, request, response)
  } catch {
    return (
      (await caches.match(request, { ignoreVary: true })) ||
      (await caches.match('/index.html', { ignoreVary: true })) ||
      (await caches.match('/', { ignoreVary: true })) ||
      Response.error()
    )
  }
}

async function handleAsset(request) {
  const cached = await caches.match(request, { ignoreVary: true })
  if (cached) return cached
  try {
    const response = await fetch(request)
    return cacheResponse(RUNTIME, request, response)
  } catch {
    return Response.error()
  }
}

self.addEventListener('fetch', (event) => {
  const url = new URL(event.request.url)
  if (event.request.method !== 'GET' || url.origin !== self.location.origin) return
  event.respondWith(
    event.request.mode === 'navigate'
      ? handleNavigation(event.request)
      : handleAsset(event.request),
  )
})
